# API base URL (no trailing slash)
# Local backend:
VITE_API_URL=http://localhost:5000/api
# Production:
# VITE_API_URL=https://api.daemon-craft.com/api

# Google reCAPTCHA v3 site key (public). Leave the placeholder to disable it locally;
# the production API requires a token on /contact.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
